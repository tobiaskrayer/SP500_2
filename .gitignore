# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtuelle Umgebungen
venv/
.venv/
env/
.env/

# IDE
.vscode/
.idea/
*.swp

# Betriebssystem
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Alte Portfolio-Datei aus der Supabase-Zeit (nur Root-Ebene) — nicht mehr genutzt.
# Führender Slash: matcht NUR /portfolio.json, nicht data/portfolio.json.
# Die aktuellen Portfolio-Daten liegen jetzt versioniert in data/portfolio.json.
/portfolio.json

# Kurs-Cache (Laufzeit-Cache, soll das Repo nicht aufblähen)
cache/prices/

# Fundamentals-Laufzeit-Cache (TTL 3 Tage) — bleibt ignoriert, damit lokale
# App-Läufe die Working Tree nicht verschmutzen. Der von GitHub Actions
# exportierte Seed (cache/fundamentals_seed.json) ist dagegen BEWUSST getrackt:
# er wärmt den Cache der deployten App nach jedem Redeploy vor.
cache/fundamentals.json

# Backtest-Cache (Preise, Ergebnisse, angereicherte Date-Daten — regenerierbar, groß)
cache/backtest/
# param_overrides.json bleibt versioniert (kleine Konfig), liegt aber in backtest/ —
# der Backtest-Cache oben betrifft nur cache/backtest/.

# Atomische Schreibvorgänge hinterlassen bei Fehler eine .tmp-Datei — nie committen
history/*.tmp

# Performance-Cache ist ein reiner Laufzeit-Cache (wird aus Log + yfinance neu
# aufgebaut) — wie cache/prices/ nicht versionieren.
history/performance_cache.json

# Hinweis: cache/*.json wird NICHT ignoriert —
# GitHub Actions committed die Analyseergebnisse täglich ins Repo.
